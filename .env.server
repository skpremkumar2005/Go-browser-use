# Server Environment Configuration Template
# Copy this to .env and configure for your server deployment

# Server Configuration - MUST CONFIGURE FOR YOUR SERVER
PORT=3000
SERVER_HOST=0.0.0.0
NODE_ENV=production
DEBUG=false

# Chrome/Browser Configuration - CONFIGURE FOR YOUR SERVER ENVIRONMENT
CHROME_PATH=google-chrome-stable
CDP_HOST=127.0.0.1
CDP_PORTS=9222,9223,9224,9225,9226,9227,9228,9229,9230

# Browser Configuration - Server optimized
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=120000
BROWSER_PROTOCOL_TIMEOUT=120000
BROWSER_LAUNCH_TIMEOUT=120000
CDP_TIMEOUT=30
TAB_SYNC_TIMEOUT=30000

# Viewport and Display Configuration for Cloud Servers
BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080
BROWSER_DEVICE_SCALE_FACTOR=1.0
BROWSER_IS_MOBILE=false
BROWSER_HAS_TOUCH=false
BROWSER_DEFAULT_VIEWPORT_WIDTH=1920
BROWSER_DEFAULT_VIEWPORT_HEIGHT=1080
DISPLAY=:99
XVFB_DISPLAY=:99
XVFB_SCREEN=0
XVFB_RESOLUTION=1920x1080x24

# Enhanced Stealth Configuration for Cloud Servers
BROWSER_DISABLE_WEB_SECURITY=false
BROWSER_DISABLE_FEATURES=VizDisplayCompositor
BROWSER_DISABLE_BACKGROUND_TIMER_THROTTLING=true
BROWSER_DISABLE_RENDERER_BACKGROUNDING=true
BROWSER_DISABLE_DEV_SHM_USAGE=true
BROWSER_NO_SANDBOX=true
BROWSER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
BROWSER_ACCEPT_LANGUAGE=en-US,en;q=0.9
BROWSER_TIMEZONE=America/New_York

# Browser Stability Settings
BROWSER_AUTO_OPEN_DEVTOOLS_FOR_TABS=false
BROWSER_DISABLE_EXTENSIONS=true
BROWSER_DISABLE_PLUGINS=true
BROWSER_DISABLE_BACKGROUND_NETWORKING=false
BROWSER_DISABLE_DEFAULT_APPS=true
BROWSER_DISABLE_SYNC=true

# Azure OpenAI Configuration - CONFIGURE YOUR API KEYS
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Alternative AI Configuration - CONFIGURE YOUR API KEYS
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Provider Selection: "azure_openai", "google", "anthropic"
LLM_PROVIDER=azure_openai

# Security Configuration - MUST CONFIGURE FOR YOUR SERVER
API_KEYS=your_secure_api_key_here
ALLOWED_ORIGINS=https://your-domain.com,http://your-domain.com:3000

# Python Agent Configuration
PYTHON_PATH=python3
AGENT_SCRIPT_PATH=../../scripts

# Session Configuration - Server optimized
SESSION_TIMEOUT=1800000  # 30 minutes
SESSION_IDLE_TIMEOUT=180000 # 3 minutes
SESSION_CLEANUP_DELAY=180000  # 3 minutes
SESSION_CLEANUP_CHECK_INTERVAL=60000  # 1 minute
MAX_SESSIONS=20
MAX_CONCURRENT_SESSIONS=10
AUTO_CLEANUP=true
FORCE_CLEANUP_ON_TASK_COMPLETE=false

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/platform.log

# Performance Configuration - Server optimized
MAX_SCREENSHOT_SIZE=2000000
FRAME_RATE=30
COMPRESSION_QUALITY=95
BROWSER_USE_WATCHDOG_TIMEOUT=60000
BROWSER_USE_EVENT_TIMEOUT=45000

# Concurrent Task Execution Configuration
MAX_CONCURRENT_TASKS=5
TASK_QUEUE_LIMIT=20
ENABLE_CONCURRENT_EXECUTION=true

# Proxy Rotation Configuration (for bypassing IP blocks)
ENABLE_PROXY_ROTATION=false
PROXY_ROTATION_INTERVAL=300000  # 5 minutes
PROXY_LIST=
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_TEST_ON_STARTUP=false