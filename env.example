# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# Browser Configuration
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080
BROWSER_DISPLAY=:0
BROWSER_XVFB_DISPLAY=:99
BROWSER_XVFB_SCREEN=0
BROWSER_XVFB_RESOLUTION=1920x1080x24

# Script Configuration
SCRIPT_PYTHON_COMMAND=python3
SCRIPT_MAX_STEPS=10
SCRIPT_DIR=./scripts
SCRIPT_TASK_SCRIPT=browser_task.py
SCRIPT_ACTION_SCRIPT=browser_action.py
SCRIPT_SCREENSHOT_SCRIPT=browser_screenshot.py

# Streaming Configuration
STREAMING_FRAME_RATE=200ms
STREAMING_COMPLETION_TIMEOUT=30s
STREAMING_LOG_INTERVAL=10

# CDP Configuration
CDP_COMMON_PORTS=9222,9223,9224,9225,9226,43031,58499,35425,42101,47507,37579,54399
CDP_TIMEOUT=1s
CDP_PING_INTERVAL=20s
CDP_PING_TIMEOUT=10s
CDP_CLOSE_TIMEOUT=10s

# Azure OpenAI Configuration (for Python scripts)
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-12-01-preview


